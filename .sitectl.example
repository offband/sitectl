# Copy this to ~/.sitectl for personal defaults across projects.
#
# Project-specific settings can live in sitectl.toml. Precedence is:
# built-in defaults < ~/.sitectl < sitectl.toml or --config < CLI flags.

max_depth = 3
timeout = 10
user_agent = "sitectl/0.1 local-first"
privacy = "strict"

# These are appended to sitectl's built-in excludes, which include /cdn-cgi/*.
excludes = [
  "admin/*",
  "*.draft.html",
]

# Usually better in a project sitectl.toml than in ~/.sitectl.
# base_url = "https://example.com"
